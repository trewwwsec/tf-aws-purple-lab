
# Local .terraform directories
.terraform/

# macOS artifacts
.DS_Store
**/.DS_Store

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore all .tfvars files (may contain secrets/credentials)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used to override resources locally and so
# are not checked in.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore plan files saved before applying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Optional: ignore graph output files
# *.dot

# Optional: ignore tf lock file (if managing provider versions globally or individually)
# .terraform.lock.hcl

# Dev resources (root-level markdown files except README and LICENSE)
# Allow common project docs: CHANGELOG, CONTRIBUTING, SECURITY, etc.
/*.md
!README.md
!LICENSE
!LICENSE.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!CLAUDE.md

# deployment data
deployments-outputs*
# Python
__pycache__/
*.pyc

# Terraform plan files
tfplan

# AI analyst runtime data
ai-analyst/baselines/*.json

# Local planning docs
docs/AI_REMEDIATION_PR_ROADMAP.md
